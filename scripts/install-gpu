#!/usr/bin/env bash
# Optional CUDA 12 engine. Keep it apart from the CPU-only onnxruntime wheel.
set -euo pipefail

if ! command -v uv >/dev/null || ! command -v nvidia-smi >/dev/null; then
  echo "Install uv and a working NVIDIA driver first." >&2
  exit 1
fi
nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
engine_dir="${XDG_DATA_HOME:-$HOME/.local/share}/dpdfnet/gpu-venv"
if [[ ! -f "$engine_dir/pyvenv.cfg" ]]; then
  if [[ -e "$engine_dir" ]]; then
    echo "The GPU directory exists and is not a virtual environment: $engine_dir" >&2
    exit 1
  fi
  uv venv --python 3.12 "$engine_dir"
fi

py="$engine_dir/bin/python"
if [[ -f "$engine_dir/.cuda-ready" ]]; then
  rm "$engine_dir/.cuda-ready"
fi
uv pip install --python "$py" 'onnxruntime-gpu==1.21.1' \
  'nvidia-cuda-runtime-cu12==12.4.127' 'nvidia-cuda-nvrtc-cu12==12.4.127' \
  'nvidia-cudnn-cu12==9.1.0.70' 'nvidia-cublas-cu12==12.4.5.8' \
  'nvidia-cufft-cu12==11.2.1.3' 'nvidia-curand-cu12==10.3.5.147' \
  'numpy>=1.26,<2.3' 'librosa>=0.11' 'soundfile>=0.13' 'filelock>=3.16' 'tqdm>=4.66'
# dpdfnet declares onnxruntime; the GPU distribution supplies the same module.
uv pip install --python "$py" --no-deps 'dpdfnet==0.6.0'
"$py" -B "$(dirname "$0")/gpu_stream.py"
touch "$engine_dir/.cuda-ready"
printf 'CUDA engine verified: %s\n' "$py"
